# Variables template for Docker Compose. Copy to .env (not versioned) and adjust.
# Password of the "postgres" user of the container.
POSTGRES_PASSWORD=<strong-password>
# Signing key of the access tokens: 32 or more characters.
ACCESS_TOKEN_SIGNING_KEY=<random-value-of-at-least-32-characters>
# IP of this computer, to open the mobile app from a phone on the same network (local only).
HOST_IP=localhost
# Production only: public URLs of the API and of the web app, and the email provider.
API_PUBLIC_URL=https://api.example.com
WEB_PUBLIC_URL=https://app.example.com
EMAIL_PROVIDER=Log
