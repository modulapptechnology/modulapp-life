{
  "name": "life-frontend",
  "private": true,
  "engines": {
    "node": "^22.13.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @life/mobile",
    "web": "npm run dev -w @life/web",
    "desktop": "npm run tauri -w @life/desktop -- dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.72.0"
  }
}
