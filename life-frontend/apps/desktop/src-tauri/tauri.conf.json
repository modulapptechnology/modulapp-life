{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ModulApp Life",
  "version": "0.1.0",
  "identifier": "com.modulapp.life",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @life/web",
    "beforeBuildCommand": "npm run build -w @life/web"
  },
  "app": {
    "windows": [
      {
        "title": "ModulApp Life",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
