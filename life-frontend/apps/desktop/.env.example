# Plantilla de la app de escritorio. Empaqueta la app web, así que usa las mismas variables que la web:
# life-frontend/.env.development, .env.test y .env.production según el script (ver README).
# Para valores locales: life-frontend/.env.local (ignorado por Git). Solo valores públicos.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:5041
