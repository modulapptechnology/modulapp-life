# Plantilla de la app móvil. Copiar a apps/mobile/.env.local (ignorado por Git) y ajustar.
# Expo lee los .env de apps/mobile, no los de la raíz. Solo valores públicos: quedan visibles en la app.
# Emulador de Android: usar http://10.0.2.2:5041. Celular físico: la IP de la PC.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:5041
