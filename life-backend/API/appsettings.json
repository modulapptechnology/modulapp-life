{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "VersionHistory": {
    "RetentionDays": 90
  },
  "Subscriptions": {
    "Reconciliation": {
      "Enabled": false,
      "IntervalMinutes": 60,
      "BatchSize": 100
    }
  },
  "AllowedHosts": "*"
}
